FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    IE_DB_PATH=/data/exchange.db

WORKDIR /app

# Coordinator deps only; llama-cpp-python is provider-side
RUN pip install \
    "fastapi>=0.115,<1" "uvicorn[standard]>=0.30,<1" "websockets>=13,<14" "pydantic>=2.9,<3" \
    "httpx>=0.27,<1" "pynacl>=1.5,<2" "cryptography>=43,<47" "huggingface-hub>=0.25,<1" \
    "sse-starlette>=2,<3" "cbor2>=5.6,<6" certifi

COPY pyproject.toml ./
COPY inference_exchange/ inference_exchange/
COPY ocip_agent/ ocip_agent/
COPY ocip_server/ ocip_server/
RUN pip install --no-deps . && useradd --system --uid 10001 ie && mkdir -p /data && chown ie /data

USER ie
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/readiness', timeout=3)"

CMD ["python", "-m", "inference_exchange.coordinator"]
