# Build the React SPA, then serve it with Caddy (which also proxies the API)
FROM node:22-alpine AS build
# Layout mirrors the repo: the /docs page imports ../docs/**/*.md at build time
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY docs/ /src/docs/
COPY web/ ./
# Public media origin for Vite's build-time URL substitution. This is NOT
# an R2 API credential. Leave empty for local review or build with
# --build-arg VITE_HERO_MEDIA_ORIGIN=https://media.inferenceex.com.
ARG VITE_HERO_MEDIA_ORIGIN=""
ENV VITE_HERO_MEDIA_ORIGIN=${VITE_HERO_MEDIA_ORIGIN}
# Opt-in alpha rollout. False is the emergency poster-only build.
# When false, absolutely no HLS manifest or video segment is requested.
ARG VITE_HERO_STREAM_ENABLED=false
ENV VITE_HERO_STREAM_ENABLED=${VITE_HERO_STREAM_ENABLED}
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/web/dist /srv/web
