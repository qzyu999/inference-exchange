# Build the React SPA, then serve it with Caddy (which also proxies the API)
FROM node:22-alpine AS build
# Layout mirrors the repo: the /docs page imports ../docs/**/*.md at build time
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY docs/ /src/docs/
COPY web/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/web/dist /srv/web
