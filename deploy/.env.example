# Copy to deploy/.env (gitignored). Never commit real values.

# Public hostname; Caddy gets a TLS cert for it automatically
IE_DOMAIN=exchange.example.com
ACME_EMAIL=ops@example.com

# Required in prod. Generate: python -c "import secrets; print(secrets.token_hex(32))"
IE_JWT_SECRET=

# GitHub OAuth app (callback: https://$IE_DOMAIN/v1/auth/github/callback)
IE_GITHUB_CLIENT_ID=
IE_GITHUB_CLIENT_SECRET=
IE_GITHUB_MIN_AGE_DAYS=30

# Comma-separated emails that get the admin role
IE_ADMIN_EMAILS=

# Operator controls (start-up values; admins can change them at runtime via /v1/admin/controls)
IE_INFERENCE_PAUSED=0
IE_SIGNUP_DISABLED=0
IE_MAX_CONCURRENT_PER_ACCOUNT=2
IE_QUEUE_MAX_DEPTH=50
IE_QUEUE_TIMEOUT_SECONDS=30

# Litestream backup target (any S3-compatible store)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
