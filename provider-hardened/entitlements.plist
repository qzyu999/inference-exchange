<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    CRITICAL: Do NOT add com.apple.security.get-task-allow
    That entitlement allows debugger attachment and defeats all hardening.
    It's only for development builds — never for production.
    -->

    <!-- Allow reading files (model weights) -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
</dict>
</plist>
